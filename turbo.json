{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "dependsOn": ["build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "passThroughEnv": ["PLAYWRIGHT_*"]
    },
    "@allurereport/web-allure2#test:e2e": {
      "dependsOn": ["build", "allure#build"],
      "passThroughEnv": ["PLAYWRIGHT_*"]
    }
  }
}
