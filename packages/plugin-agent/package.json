{
  "name": "@allurereport/plugin-agent",
  "version": "3.21.0",
  "description": "Allure Agent Plugin – AI-friendly markdown report generator",
  "keywords": [
    "agent",
    "allure",
    "markdown",
    "plugin",
    "report",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "files": [
    "./dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json",
    "clean": "rimraf ./dist",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint": "vp lint --import-plugin src test features stories",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "dependencies": {
    "@allurereport/core-api": "workspace:*",
    "@allurereport/plugin-api": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@allurereport/common-config": "workspace:*",
    "@allurereport/reader-api": "workspace:*",
    "@types/node": "^20",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/runner": "^2",
    "allure-js-commons": "^3",
    "allure-vitest": "^3",
    "rimraf": "^6",
    "typescript": "^5",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
