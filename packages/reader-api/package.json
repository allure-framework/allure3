{
  "name": "@allurereport/reader-api",
  "version": "3.21.0",
  "description": "Allure Reader API",
  "keywords": [
    "allure",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json",
    "clean": "rimraf ./dist",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint": "vp lint --import-plugin src test features stories",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "dependencies": {
    "@allurereport/core-api": "workspace:*",
    "@allurereport/plugin-api": "workspace:*",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@allurereport/common-config": "workspace:*",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/runner": "^2",
    "allure-js-commons": "^3.14.0",
    "allure-vitest": "^3.14.0",
    "rimraf": "^6",
    "ts-node": "^10.9.2",
    "tslib": "^2.7.0",
    "typescript": "^5",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
