{
  "name": "@allurereport/common-config",
  "version": "3.22.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./playwright": "./src/playwright.ts"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json",
    "clean": "rimraf ./dist",
    "report:merge": "node src/scripts/merge-blob-reports.ts",
    "report:coverage": "yarn report:merge && (vp test run --merge-reports .vitest/merged-blob || true)"
  },
  "dependencies": {
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/runner": "4.1.8",
    "allure-vitest": "^3.14.0",
    "glob": "^13.0.6",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "^20",
    "allure-js-commons": "^3.14.0",
    "rimraf": "^6",
    "typescript": "^5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": "^1"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
