{
  "name": "sandbox",
  "version": "3.22.1",
  "private": true,
  "description": "A package to test another Allure Report packages in action",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "type": "module",
  "scripts": {
    "g": "yarn allure generate --config=./allurerc.mjs",
    "o": "yarn allure open ./allure-report",
    "pret": "rimraf ./allure-results",
    "t": "yarn allure run -- vitest run",
    "test": "rimraf out && vp test run",
    "lint": "vp lint --import-plugin src test features stories",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "devDependencies": {
    "@allurereport/plugin-awesome": "workspace:*",
    "@allurereport/plugin-csv": "workspace:*",
    "@allurereport/plugin-mail": "workspace:*",
    "@allurereport/plugin-testops": "workspace:*",
    "@types/node": "^20.19.43",
    "@vitest/runner": "4.1.12",
    "allure": "workspace:*",
    "allure-js-commons": "^3.14.0",
    "allure-vitest": "^3.14.0",
    "rimraf": "^6.1.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "packageManager": "yarn@4.3.1"
}
