{
  "name": "@allurereport/web-classic",
  "version": "3.22.0",
  "private": true,
  "description": "The static files for Allure Classic Report",
  "keywords": [
    "allure",
    "html",
    "report",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "files": [
    "./dist"
  ],
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "dev": "run-s dev:demo dev:copy dev:serve",
    "dev:demo": "rimraf out/demo && yarn run -T allure generate ${ALLURE_RESULTS_DIR:-../sandbox/allure-results} --config=./allurerc-dev.mjs --output=./out/demo",
    "dev:copy": "rimraf out/dev/data out/dev/widgets && mkdir -p out/dev && cp -R out/demo/data out/dev/data && cp -R out/demo/widgets out/dev/widgets",
    "dev:serve": "webpack serve --mode development",
    "build": "run clean && run build:prod:multi",
    "build:dev": "run-s clean build:dev:multi",
    "build:prod:multi": "webpack --mode production",
    "build:dev:multi": "webpack --mode development",
    "lint": "vp lint --import-plugin src test features stories",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "devDependencies": {
    "@allurereport/common-config": "workspace:*",
    "@allurereport/core-api": "workspace:*",
    "@allurereport/plugin-api": "workspace:*",
    "@allurereport/web-commons": "workspace:*",
    "@allurereport/web-components": "workspace:*",
    "@babel/core": "^7.27.4",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^7.27.1",
    "@floating-ui/dom": "^1.8.0",
    "@preact/signals": "^2.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/d3-shape": "^3.1.8",
    "@types/md5": "^2.3.6",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/runner": "^2",
    "@vitest/snapshot": "catalog:",
    "allure-js-commons": "^3.14.0",
    "allure-vitest": "^3.14.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^10.1.1",
    "babel-plugin-prismjs": "^2.1.0",
    "clsx": "^2.1.1",
    "css-loader": "^7.1.4",
    "d3-shape": "^3.2.0",
    "filesize": "^10.1.6",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "globals": "^15.9.0",
    "html-webpack-plugin": "^5.6.3",
    "i18next": "^24.0.2",
    "jsdom": "^26.0.0",
    "md5": "^2.3.0",
    "npm-run-all2": "^7.0.1",
    "postcss": "^8.5.10",
    "preact": "^10.29.8",
    "prismjs": "^1.30.0",
    "rimraf": "^6",
    "sass": "^1.79.1",
    "sass-loader": "^16.0.1",
    "split.js": "^1.6.5",
    "style-loader": "^4.0.0",
    "typescript": "^5",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "webpack": "^5",
    "webpack-cli": "^7",
    "webpack-dev-server": "^5.2.4",
    "webpack-manifest-plugin": "^6"
  }
}
