{
  "name": "@allurereport/core",
  "version": "3.22.1",
  "description": "Collection of generic Allure utilities used across the entire project",
  "keywords": [
    "allure"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json",
    "clean": "rimraf ./dist",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint": "vp lint --import-plugin src test features stories",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "dependencies": {
    "@allurereport/ci": "workspace:*",
    "@allurereport/cli-commons": "workspace:*",
    "@allurereport/core-api": "workspace:*",
    "@allurereport/plugin-agent": "workspace:*",
    "@allurereport/plugin-allure2": "workspace:*",
    "@allurereport/plugin-api": "workspace:*",
    "@allurereport/plugin-awesome": "workspace:*",
    "@allurereport/plugin-classic": "workspace:*",
    "@allurereport/plugin-csv": "workspace:*",
    "@allurereport/plugin-dashboard": "workspace:*",
    "@allurereport/plugin-jira": "workspace:*",
    "@allurereport/plugin-log": "workspace:*",
    "@allurereport/plugin-metrics": "workspace:*",
    "@allurereport/plugin-progress": "workspace:*",
    "@allurereport/plugin-slack": "workspace:*",
    "@allurereport/plugin-testops": "workspace:*",
    "@allurereport/plugin-testplan": "workspace:*",
    "@allurereport/plugin-xray": "workspace:*",
    "@allurereport/reader": "workspace:*",
    "@allurereport/reader-api": "workspace:*",
    "@allurereport/service": "workspace:*",
    "@allurereport/summary": "workspace:*",
    "glob": "^13.0.6",
    "handlebars": "^4.7.10",
    "jiti": "^2.5.1",
    "node-stream-zip": "^1.15.0",
    "p-limit": "^7.3.0",
    "yaml": "^2.9.1",
    "yoctocolors": "^2.2.0",
    "zip-stream": "^7.0.5"
  },
  "devDependencies": {
    "@allurereport/common-config": "workspace:*",
    "@types/node": "^20.19.43",
    "@types/zip-stream": "^7.0.0",
    "@vitest/coverage-istanbul": "5.0.5",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "5.0.5",
    "allure-js-commons": "^3.14.0",
    "allure-node-performance": "^3.14.0",
    "allure-vitest": "^3.14.0",
    "rimraf": "^6.1.3",
    "tslib": "^2.7.0",
    "typescript": "^5.9.3",
