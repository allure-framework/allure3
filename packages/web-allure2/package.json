{
  "name": "@allurereport/web-allure2",
  "version": "3.16.1",
  "private": true,
  "description": "The web source and built static files for the Allure 2-compatible report",
  "keywords": [
    "allure",
    "html",
    "report",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "files": [
    "./dist"
  ],
  "type": "module",
  "scripts": {
    "clean": "rimraf dist build",
    "dev": "run-s build dev:demo dev:serve",
    "dev:demo": "rimraf build/demo-report && yarn run -T allure generate ${ALLURE_RESULTS_DIR:-../sandbox/allure-results} --config=./allurerc-dev.mjs --output=./build/demo-report",
    "dev:serve": "vite --host=0.0.0.0 --port=3000",
    "build": "run-s clean typecheck build:prod",
    "build:dev": "run-s clean typecheck build:dev:bundle",
    "build:prod": "vite build --mode production",
    "build:dev:bundle": "vite build --mode development",
    "test": "run-s typecheck:e2e test:e2e",
    "test:e2e": "playwright test --config playwright.config.mts",
    "test:e2e:accessibility": "playwright test --config playwright.config.mts tests/e2e/accessibility.spec.mts --workers=1",
    "test:e2e:headed": "playwright test --config playwright.config.mts --headed",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:prepare": "tsx scripts/prepare-playwright-report.mts",
    "test:e2e:ui": "playwright test --config playwright.config.mts --ui",
    "format": "oxfmt --write 'src/main/javascript/**/*.{mts,css,scss}' 'scripts/*.mts' 'tests/e2e/**/*.mts' package.json tsconfig.json tsconfig.e2e.json .oxlintrc.json vite.config.mts playwright.config.mts allurerc-dev.mjs allurerc-e2e.mjs",
    "format:check": "oxfmt --check 'src/main/javascript/**/*.{mts,css,scss}' 'scripts/*.mts' 'tests/e2e/**/*.mts' package.json tsconfig.json tsconfig.e2e.json .oxlintrc.json vite.config.mts playwright.config.mts allurerc-dev.mjs allurerc-e2e.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "lint": "run-s format:check typecheck:e2e lint:code",
    "lint:code": "oxlint --import-plugin --config .oxlintrc.json src/main/javascript scripts tests/e2e playwright.config.mts",
    "lint:fix": "run-s format lint:code:fix",
    "lint:code:fix": "oxlint --import-plugin --config .oxlintrc.json --fix src/main/javascript scripts tests/e2e playwright.config.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-brush": "^3.0.6",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-dsv": "^3.0.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^26.4.0",
    "allure-js-commons": "^3",
    "allure-playwright": "^3.10.2",
    "ansi-to-html": "^0.7.2",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.4",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-brush": "^3.0.0",
    "d3-drag": "^3.0.0",
    "d3-dsv": "^3.0.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "filesize": "^10.1.1",
    "highlight.js": "^11.11.1",
    "i18next": "^26.0.5",
    "normalize-css": "^2.3.1",
    "npm-run-all2": "^7.0.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "postcss": "^8.5.25",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "split.js": "^1.6.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.9"
  },
  "browserslist": [
    "defaults"
  ]
}
