{
  "name": "@allurereport/plugin-server-reload",
  "version": "3.22.1",
  "description": "Allure Plugin to reload Allure Static Server on state change",
  "keywords": [
    "allure",
    "plugin",
    "report",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "files": [
    "./dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json",
    "clean": "rimraf ./dist",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint": "vp lint --import-plugin src test features stories",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "dependencies": {
    "@allurereport/plugin-api": "workspace:*",
    "@allurereport/static-server": "workspace:*"
  },
  "devDependencies": {
    "@allurereport/common-config": "workspace:*",
    "@types/node": "^20.19.43",
    "@vitest/coverage-istanbul": "5.0.5",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "5.0.5",
    "allure-js-commons": "^3.14.0",
    "allure-vitest": "^3.14.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  }
}
