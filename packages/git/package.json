{
  "name": "@allurereport/git",
  "version": "3.22.0",
  "description": "Git metadata collection for Allure Git Flow",
  "keywords": [
    "allure",
    "git",
    "report",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "files": [
    "./dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json",
    "clean": "rimraf ./dist",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint": "vp lint --import-plugin src test",
    "lint:fix": "vp lint --import-plugin --fix src test"
  },
  "dependencies": {
    "@allurereport/core-api": "workspace:*"
  },
  "devDependencies": {
    "@allurereport/common-config": "workspace:*",
    "@types/node": "^20",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/runner": "^2",
    "@vitest/snapshot": "catalog:",
    "allure-vitest": "^3",
    "rimraf": "^6",
    "typescript": "^5",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
