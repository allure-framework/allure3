{
  "name": "@allurereport/web-commons",
  "version": "3.22.1",
  "description": "Collection of utilities used across the web Allure reports",
  "keywords": [
    "allure",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json",
    "clean": "rimraf ./dist",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint": "vp lint --import-plugin src test features stories",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "dependencies": {
    "@allurereport/aql": "workspace:*",
    "@allurereport/charts-api": "workspace:*",
    "@allurereport/core-api": "workspace:*",
    "@allurereport/plugin-api": "workspace:*",
    "@preact/signals": "^2.6.1",
    "@preact/signals-core": "^1.12.2",
    "ansi-to-html": "^0.7.2",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.4.17",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "@allurereport/common-config": "workspace:*",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/runner": "^4.1.12",
    "allure-js-commons": "^3.14.0",
    "allure-vitest": "^3.14.0",
    "jsdom": "^26.1.0",
    "rimraf": "^6.1.3",
    "tslib": "^2.7.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
    "vite-plus": "^1.3.0",
    "vitest": "^5.0.5"
  }
}
