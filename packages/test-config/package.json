{
  "name": "@allurereport/test-config",
  "version": "3.21.0",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json",
    "clean": "rimraf ./dist",
    "report:merge": "node dist/scripts/merge-blob-reports.js",
    "report:coverage": "yarn report:merge && vp test run --merge-reports .vitest/merged-blob"
  },
  "dependencies": {
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/runner": "4.1.8",
    "allure-vitest": "^3",
    "glob": "^13.0.6",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "^20",
    "allure-js-commons": "^3",
    "rimraf": "^6",
    "typescript": "^5",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
