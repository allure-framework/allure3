{
  "name": "@allurereport/plugin-classic",
  "version": "3.22.1",
  "description": "The classic version of Allure HTML report",
  "keywords": [
    "allure",
    "html",
    "plugin",
    "report",
    "testing"
  ],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": "https://github.com/allure-framework/allure3",
  "files": [
    "./dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "run clean && tsc --project ./tsconfig.json && node ../../scripts/pack-report-static.mjs ../web-classic/dist/multi ./dist/static/report.tar",
    "clean": "rimraf ./dist",
    "test": "rimraf out && vp test run",
    "test:unit": "yarn test",
    "lint": "vp lint --import-plugin src test features stories",
    "lint:fix": "vp lint --import-plugin --fix src test features stories"
  },
  "dependencies": {
    "@allurereport/charts-api": "workspace:*",
    "@allurereport/core-api": "workspace:*",
    "@allurereport/plugin-api": "workspace:*",
    "@allurereport/web-commons": "workspace:*",
    "d3-shape": "^3.2.0",
    "handlebars": "^4.7.10",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@allurereport/common-config": "workspace:*",
    "@allurereport/web-classic": "workspace:*",
    "@types/d3-shape": "^3.1.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.19.43",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/runner": "^4.1.12",
    "allure-js-commons": "^3.14.0",
    "allure-vitest": "^3.14.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
    "vite-plus": "^1.3.0",
    "vitest": "^5.0.5"
  }
}
