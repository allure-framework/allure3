{
  "name": "@allurereport/monorepo",
  "version": "3.22.1",
  "private": true,
  "description": "Allure framework TypeScript implementation",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "Qameta Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allure-framework/allure3.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "archive": "yarn allure archive",
    "audit": "yarn npm audit --all --recursive",
    "build": "vp run -v --log labeled -F '{packages/*}' -F '!sandbox' vp:build",
    "check": "vp check",
    "clean": "vp run -rv --log labeled --parallel clean",
    "clean:cache": "rimraf node_modules/.vite/task-cache",
    "coverage": "yarn workspace @allurereport/common-config run report:coverage",
    "format": "yarn format:write",
    "report": "yarn allure generate --config=./allurerc.mjs",
    "test": "yarn workspaces foreach -Avvp --exclude  @allurereport/monorepo --exclude @allurereport/common-config --exclude sandbox exec vp run -v vp:test",
    "test:unit": "yarn workspaces foreach -Avvp --exclude sandbox run test:unit",
    "test:e2e": "yarn workspaces foreach -Avvp run test:e2e",
    "lint": "yarn workspaces foreach -Avvp run lint",
    "lint:fix": "yarn workspaces foreach -Avvp run lint:fix",
    "lint:type": "vp lint --type-aware",
    "verify": "yarn check --quiet && yarn typecheck --quiet",
    "format:check": "vp fmt --check",
    "format:write": "vp fmt --write",
    "allure:size": "node ./scripts/allure-bundle-size.mjs --progress --emojis --include-closure",
    "allure:size:docker": "bash ./scripts/run-allure-bundle-size-docker.sh",
    "typecheck": "node ./scripts/check-types.mjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "allure": "workspace:*",
    "babel-plugin-prismjs": "^2.1.0",
    "lefthook": "^2.1.4",
    "rimraf": "^6",
    "tslib": "^2.7.0",
    "typescript": "^5",
    "vite-plus": "catalog:"
  },
  "resolutions": {
    "@babel/core": "7.29.7",
    "@preact/compat": "^18.3.1",
    "@preact/signals": "^2.6.1",
    "@preact/signals-core": "^1.12.2",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.9",
    "colord": "2.9.4",
    "compression": "1.8.2",
    "dompurify": "3.4.17",
    "esbuild": "^0.25.0",
    "fast-uri": "3.1.8",
    "fast-xml-parser": "^5.7.0",
    "http-cache-semantics": "4.3.0",
    "http-proxy-middleware": "2.0.10",
    "immutable@npm:^4.0.0": "4.3.9",
    "immutable@npm:^5.0.2": "5.1.8",
    "ip-address@npm:^9.0.5": "10.7.4",
    "js-yaml@npm:^4.1.0": "5.4.3",
    "linkify-it@npm:^5.0.1": "5.0.2",
    "lodash": "^4.18.1",
    "micromatch": "^4.0.8",
    "on-headers": "^1.1.0",
    "path-to-regexp": "^0.1.13",
    "postcss-selector-parser@npm:^6.0.2": "7.1.6",
    "postcss-selector-parser@npm:^6.0.4": "7.1.6",
    "postcss-selector-parser@npm:^6.0.5": "7.1.6",
    "postcss-selector-parser@npm:^6.0.9": "7.1.6",
    "postcss-selector-parser@npm:^7.0.0": "7.1.6",
    "preact": "^10.25.0",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "react": "npm:@preact/compat@*",
    "react-dom": "npm:@preact/compat@*",
    "semver": "^7.5.2",
    "serialize-javascript@npm:^6.0.1": "7.0.5",
    "serialize-javascript@npm:^6.0.2": "7.0.5",
    "shell-quote@npm:1.9.0": "1.12.0",
    "shell-quote@npm:^1.7.3": "1.12.0",
    "shell-quote@npm:^1.8.4": "1.12.0",
    "source-map-js": "1.2.2",
    "svgo@npm:^2.7.0": "2.8.4",
    "svgo@npm:^3.0.2": "3.3.5",
    "tar": "7.5.22",
    "tinypool": "2.1.2",
    "uuid@npm:^8.3.2": "11.1.1",
    "uuid@npm:^9.0.0": "11.1.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vitest": "5.0.4",
    "webpack-dev-middleware": "7.4.6",
    "webpack-dev-server": "5.2.6",
    "websocket-driver@npm:^0.7.4": "0.7.5",
    "ws": "8.21.0"
  },
  "browserslist": [
    "defaults"
  ],
  "packageManager": "yarn@4.18.1"
}
